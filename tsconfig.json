{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "module": "ES2022",
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": false,
    "experimentalDecorators": true,
    "target": "ES2022",
    "importHelpers": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "typeRoots": [
      "node_modules/@types"
    ],
    "paths": {
      "ccd-case-ui-toolkit": [
        "./dist/ccd-case-ui-toolkit"
      ],
      "ccd-case-ui-toolkit/*": [
        "./dist/ccd-case-ui-toolkit/*"
      ]
    },
    "strict": false
  }
}
