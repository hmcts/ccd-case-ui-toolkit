#!groovy

@Library('Infrastructure@2.4.5') _

properties([
  [$class: 'GithubProjectProperty',
   displayName: 'CCD Case UI Toolkit',
   projectUrlStr: 'https://github.com/hmcts/ccd-case-ui-toolkit'],
  pipelineTriggers(env.BRANCH_NAME == 'master' ? [cron('30 17 * * 1-5')] : [])
])

new uk.gov.hmcts.pipeline.TeamConfig(this).setTeamConfigEnv('xui')

node(env.BUILD_AGENT_TYPE) {
  checkout scm
  load('playwright_tests/jenkins/validate.groovy').call()
}
