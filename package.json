{
  "name": "@hmcts/ccd-case-ui-toolkit",
  "version": "7.4.28-5630",
  "engines": {
    "node": ">=24.22.2"
  },
  "description": "Case UI Toolkit",
  "main": "./dist/index.umd.js",
  "module": "./dist/index.js",
  "typings": "./dist/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hmcts/ccd-case-ui-toolkit.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "serve:playwright": "ng serve toolkit-playwright-host --host 127.0.0.1 --port 4300",
    "test:playwright": "playwright test --config playwright_tests/playwright.config.ts",
    "test:playwright:typecheck": "tsc -p playwright_tests/tsconfig.json && ngc -p playwright_tests/host/tsconfig.json --noEmit",
    "test:packaged-consumer": "node --test scripts/webapp-material-contract.test.mjs && npm run build && node scripts/packaged-consumer-smoke.mjs",
    "test:packaged-consumer:strict": "npm run build && node scripts/packaged-consumer-smoke.mjs --strict-peer-deps",
    "lint:playwright": "eslint \"playwright_tests/**/*.ts\" \"packaged-consumer/tests/**/*.ts\" \"packaged-consumer/playwright.config.ts\"",
    "lint:playwright:reporting": "node --check playwright_tests/reporters/odhin-feature-reporter.cjs && node --check playwright_tests/reporters/odhin-report-enhancer.cjs && node --check playwright_tests/reporters/odhin-progress.reporter.cjs && node --check scripts/ensure-odhin-report.js && node --check playwright_tests/reporters/presentation/report.js && node --test playwright_tests/reporters/presentation/*.test.cjs playwright_tests/fixtures/*.test.cjs scripts/*.test.mjs",
    "test:fullfunctional": "yarn test:playwright:typecheck && yarn test:playwright",
    "prepare": "yarn build && husky",
    "build": "npm run build:library",
    "build:library": "npm run generate:condition-parser && ng build ccd-case-ui-toolkit-lib && node ./scripts/sync-dist-package.mjs",
    "build:library:watch": "ng build ccd-case-ui-toolkit-lib --watch",
    "build:watch": "concurrently --raw \"npm run build:umd:watch\"",
    "ci": "npm run lint && npm run test && npm run build && npm run docs",
    "clean": "rimraf node_modules",
    "clean:all": "npm run clean:tmp && rimraf node_modules",
    "clean:tmp": "rimraf coverage dist tmp docs",
    "coverage": "nyc report --reporter=json && codecov -f coverage/coverage-final.json",
    "docs": "compodoc -p tsconfig.json -d docs --disableCoverage --disablePrivate --disableProtected --disableInternal --disableLifeCycleHooks",
    "explorer": "source-map-explorer ./dist/index.umd.js",
    "gh-pages": "rimraf docs && npm run docs && gh-pages -d docs",
    "lint": "ng lint ccd-case-ui-toolkit",
    "ngcompile": "node_modules/.bin/ngc -p tsconfig-aot.json",
    "postversion": "git push && git push --tags",
    "prebuild": "rimraf dist tmp",
    "prebuild:watch": "rimraf dist tmp",
    "preversion": "npm run ci",
    "build:ng:test": "ng build",
    "test": "ng test ccd-case-ui-toolkit-lib --code-coverage",
    "test:watch": "ng test ccd-case-ui-toolkit-lib --code-coverage --watch=true",
    "test:audit": "./bin/run-yarn-audit.sh -f yarn-audit-known-issues",
    "tslint": "tslint",
    "generate:condition-parser": "peggy --format es -o projects/ccd-case-ui-toolkit/src/lib/shared/directives/conditional-show/services/condition-parser.generated.ts projects/ccd-case-ui-toolkit/src/lib/shared/directives/conditional-show/services/condition.peggy && node -e 'const fs = require(\"fs\"); const p = \"projects/ccd-case-ui-toolkit/src/lib/shared/directives/conditional-show/services/condition-parser.generated.ts\"; const s = fs.readFileSync(p, \"utf8\"); fs.writeFileSync(p, \"// @ts-nocheck\\n// This file is generated by npm run generate:condition-parser. Do not edit by hand.\\n\" + s);'",
    "prepush": "yarn install --mode=skip-build && yarn test:audit && yarn lint"
  },
  "dependencies": {
    "@angular/animations": "^20.3.35",
