    "@hmcts/media-viewer": "4.2.49-5630",
    "@ngrx/effects": "^20.1.0",
    "@ngrx/store": "^20.1.0",
    "@ngxmc/datetime-picker": "20.1.0",
    "file-saver": "^2.0.5",
